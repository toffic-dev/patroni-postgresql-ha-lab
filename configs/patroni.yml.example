# Patroni configuration example
# Based on the working three-node PostgreSQL HA lab.
# Replace node-specific values before deployment.
# Never commit real passwords.

scope: patroni-lab
namespace: /service/
name: patroni1

restapi:
  listen: 0.0.0.0:8008
  connect_address: 192.168.116.129:8008

etcd3:
  hosts:
    - 192.168.116.129:2379
    - 192.168.116.132:2379
    - 192.168.116.133:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        wal_log_hints: "on"
        max_wal_senders: 5
        max_replication_slots: 5
        wal_keep_size: 128MB
        max_connections: 50
        shared_buffers: 128MB
        work_mem: 4MB
        maintenance_work_mem: 32MB
        max_worker_processes: 4
        max_parallel_workers: 2
        max_parallel_workers_per_gather: 1
        max_wal_size: 512MB
        min_wal_size: 80MB
        checkpoint_timeout: 15min
        password_encryption: scram-sha-256

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host replication replicator 192.168.116.0/24 scram-sha-256
    - host all all 192.168.116.0/24 scram-sha-256

postgresql:
  listen: 0.0.0.0:5432
  connect_address: 192.168.116.129:5432
  data_dir: /var/lib/postgresql/18/patroni
  bin_dir: /usr/lib/postgresql/18/bin

  authentication:
    superuser:
      username: postgres
      password: "REPLACE_WITH_POSTGRES_PASSWORD"
    replication:
      username: replicator
      password: "REPLACE_WITH_REPLICATION_PASSWORD"
