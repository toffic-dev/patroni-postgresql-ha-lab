# Patroni configuration example
# Lab use only. Replace node-specific values before deployment.
# Never put real passwords in a public repository.

scope: patroni-lab
namespace: /service/
name: patroni1

restapi:
  listen: 0.0.0.0:8008
  connect_address: 192.168.116.129:8008

etcd3:
  hosts:
    - 192.168.116.129:2379
    - 192.168.116.132:2379
    - 192.168.116.133:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        max_connections: 50
        shared_buffers: 128MB
        work_mem: 4MB
        maintenance_work_mem: 32MB
        wal_level: replica
        hot_standby: "on"

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - host replication replicator 192.168.116.0/24 scram-sha-256
    - host all all 192.168.116.0/24 scram-sha-256

postgresql:
  listen: 0.0.0.0:5432
  connect_address: 192.168.116.129:5432
  data_dir: /var/lib/postgresql/18/patroni
  bin_dir: /usr/lib/postgresql/18/bin

  authentication:
    superuser:
      username: postgres
      password: "REPLACE_WITH_YOUR_POSTGRES_PASSWORD"
    replication:
      username: replicator
      password: "REPLACE_WITH_YOUR_REPLICATION_PASSWORD"

  parameters:
    unix_socket_directories: /var/run/postgresql
